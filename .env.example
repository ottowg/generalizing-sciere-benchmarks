# Data directories for UnifiedSciERE
# Copy this file to .env and adjust paths as needed

DATA_GOLD_FOLDER=data/gold
DATA_PREDICTIONS_FOLDER=data/predictions

# OpenAlex polite-pool identifier (used by scripts/outlet_metadata/enrich_outlet.py)
# Adding your e-mail enables 10 req/s instead of 1 req/s.
# See: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=your@email.com

# Webapp dev server host (set to a local IP to expose on the network)
WEBAPP_HOST=localhost

# HuggingFace Spaces deployment (used by scripts/deploy_hf.sh)
# Create a token at https://huggingface.co/settings/tokens with write access
HF_TOKEN=hf_your_token_here
HF_SPACE_USERNAME=your-anon-hf-username
HF_SPACE_NAME=unifiedsciere
